# Copy this file to src/.env and fill in real values. Never commit the
# real file — it's already covered by .gitignore.
#
# NOTE: as of Phase 1, most of these still have hardcoded fallback defaults
# in source (see docs/IMPROVEMENT-PLAN.md §4) — that's the specific thing
# Phase 4 removes. This file exists now so nothing is forgotten by then.

# --- Database (Railway-hosted MySQL) ---
MYSQLHOST=
MYSQLPORT=
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=

# --- Auth ---
JWT_SECRET=

# --- AI feature (Phase 1) ---
OPENAI_API_KEY=
GEOAPIFY_API_KEY=
NEWS_SOURCE_URL=https://www.iol.co.za/rss

# --- Routing ---
OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving

# --- Server ---
PORT=3000
