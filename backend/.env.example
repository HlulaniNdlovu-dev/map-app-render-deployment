# Copy this file to src/.env and fill in real values. Never commit the
# real file — it's already covered by .gitignore.
#
# All of these are required at startup with no hardcoded fallback (except
# NEWS_SOURCE_URL, OSRM_BASE_URL, and PORT, which default sensibly if
# omitted) — the server fails fast with a clear error naming exactly which
# variable is missing rather than silently using a checked-in secret.

# --- Database (Railway-hosted MySQL) ---
MYSQLHOST=
MYSQLPORT=
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=

# --- Auth ---
JWT_SECRET=

# --- AI feature (Phase 1) ---
OPENAI_API_KEY=
GEOAPIFY_API_KEY=
NEWS_SOURCE_URL=https://www.iol.co.za/rss

# --- Routing ---
OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving

# --- Server ---
PORT=3000
